# Set these in the process environment; this file is not loaded automatically.
GEMINI_API_KEY=
# Optional alias accepted only by explicit live verification scripts.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Enable only after explicit approval of the external payload and destination.
WORKSPACE_ALLOW_LIVE=0
# Synthetic mode is confined to an isolated verification database.
WORKSPACE_VERIFICATION=0
WORKSPACE_DB=data/workspace.sqlite3
WORKSPACE_SEED=tasks/evidence/seed.json
# Current-prompt Q1–Q8 captures, including the documented Q1 correction.
# Use gemini-3.8-flash for synthetic fixtures instead.
WORKSPACE_REPLAY_DIR=examples/real-replay
